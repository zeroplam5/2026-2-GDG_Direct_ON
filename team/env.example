# 저장소 루트에 .env 로 복사해서 쓰기:  cp team/env.example .env
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다. 키 값을 이 파일(env.example)에 쓰지 말 것.
# 상담원 서버는 시작할 때 저장소 루트의 .env 를 자동으로 읽는다 (이미 있는 환경 변수가 우선).

# ── API 키 (값은 .env 에만) ─────────────────────────────
OPENAI_API_KEY=
# 11/21 공식 모델용 (feature/new-models 브랜치의 provider 필요)
SONIOX_API_KEY=
GEMINI_API_KEY=

# ── 모델 선택 ───────────────────────────────────────────
# 기본값: STT gpt-4o-mini-transcribe / LLM gpt-5.4-mini (11/21 공식) / TTS gpt-4o-mini-tts (OPENAI_API_KEY 하나로 동작)
# 11/21 공식 모델로 바꿀 때 아래 다섯 줄의 # 을 지운다 (모델 이름은 공식 README 기준)
# AGENT_STT_PROVIDER=soniox
# AGENT_TTS_PROVIDER=gemini
# AGENT_LLM_MODEL=gpt-5.4-mini
# AGENT_SONIOX_MODEL=stt-rt-v6
# AGENT_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts

# Soniox 키를 보내는 방식 (실제 키로 아직 확인 안 됨)
#   config = 첫 설정 메시지에 api_key (기본, 지금까지 방식)
#   header = Authorization: Bearer 헤더 (대회 사이트 예제 방식)
#   both   = 둘 다
# Soniox 접속이 인증 오류로 실패하면 아래 줄의 # 을 지우고 다시 실행
# AGENT_SONIOX_AUTH=header

# 게이트웨이(baze)로 Soniox 실시간 STT 쓰기: OPENAI_API_KEY(게이트웨이 키)를 Bearer 헤더로 보냄
# AGENT_STT_PROVIDER=soniox
# AGENT_SONIOX_URL=wss://api.baze.co/v1/gateway/soniox/transcribe-websocket
# AGENT_SONIOX_API_KEY_ENV=OPENAI_API_KEY
# AGENT_SONIOX_AUTH=both

# ── 측정 당일 ───────────────────────────────────────────
# AGENT_PORT=9000
# AGENT_LOG_TEXT=0          # 1이면 인식 텍스트·응답을 로그에 남김 (시험 문항 내용 저장 주의)

# ── 통합 후 기능 스위치 (prototype 브랜치, 아래 값이 기본값) ─────────
# AGENT_TOOL_GATE=1               # 실행 전 관문 (llm-gate). 0이면 끔
# AGENT_NUMBER_SLOTS=1            # KULLM이 고객 말 속 전화·주문번호를 가려서([PHONE]) 자리 이름+자리표로 보냄. 0이면 끔
# AGENT_PREFETCH=1                # 주문·반품 조회를 미리 실제로 부름(발신자 번호는 통화 시작에, 고객 말 번호는 턴 시작에). 접수는 절대 안 함. 0이면 끔
# AGENT_WRITE_ANSWER_AHEAD=1      # 접수를 보내는 동안 "ok라면 할 말"을 미리 씀. 실제 결과가 ok일 때만 결과 뒤에 말함. 0이면 끔
# AGENT_LLM_WARM_IDLE_S=240       # LLM 예열: 이만큼(초) LLM 호출이 없었으면 새 통화 시작 때 실제 프롬프트로 짧은 호출 하나. 0이면 끔
# AGENT_OUTPUT_GUARD=log          # log=근거 없는 숫자는 기록만(반복 문장은 버림) / block / off
# AGENT_TOOL_ACK=0                # 조회 중 멘트 (latency). 팀 결정·매뉴얼 확인 전 꺼 둠
# AGENT_FIRST_CHUNK_MIN_CHARS=0   # 첫 조각 쉼표 끊기 (latency). 측정 때 8 사용
# AGENT_EOU_MODE=vad              # vad(기존) / soniox_stream(실제 키 미검증, 비교용)
# AGENT_RESUME_BEFORE_AUDIO=0     # 1이면 말 끝 판정 뒤에도 첫 소리 전까지 계속 듣고, 손님이 이어 말하면 준비 중 답을 취소하고 앞뒤를 한 발화로 다시 판정 (vad 모드만, 접수 함수를 이미 보냈으면 취소 안 함. 조회는 다시 불러도 되므로 취소함)
# AGENT_PACK_DIR=                 # 묶음 폴더. 기본은 공식 묶음(team/agent/packs/official), 연습 묶음은 team/agent/prompts
# AGENT_BRAND_DIR=data/brand  # 키트 배치 그대로 저장소 맨 위 data/brand (시나리오·브랜드 정보·말투). git에 올리지 않음
