# 저장소 루트에 .env 로 복사해서 쓰기:  cp team/env.example .env
# .env 는 .gitignore 에 들어 있어 커밋되지 않는다. 키 값을 이 파일(env.example)에 쓰지 말 것.
# 상담원 서버는 시작할 때 저장소 루트의 .env 를 자동으로 읽는다 (이미 있는 환경 변수가 우선).

# ── API 키 (값은 .env 에만) ─────────────────────────────
OPENAI_API_KEY=
# 11/21 공식 모델용 (feature/new-models 브랜치의 provider 필요)
SONIOX_API_KEY=
GEMINI_API_KEY=

# ── 모델 선택 ───────────────────────────────────────────
# 기본값: STT gpt-4o-mini-transcribe / LLM gpt-5.4-mini (11/21 공식) / TTS gpt-4o-mini-tts (OPENAI_API_KEY 하나로 동작)
# 11/21 공식 모델로 바꿀 때 아래 세 줄의 # 을 지운다
# AGENT_STT_PROVIDER=soniox
# AGENT_TTS_PROVIDER=gemini
# AGENT_LLM_MODEL=gpt-5.4-mini

# ── 측정 당일 ───────────────────────────────────────────
# AGENT_PORT=9000
# AGENT_LOG_TEXT=0          # 1이면 인식 텍스트·응답을 로그에 남김 (시험 문항 내용 저장 주의)

# ── 통합 후 기능 스위치 (prototype 브랜치, 아래 값이 기본값) ─────────
# AGENT_TOOL_GATE=1               # 실행 전 관문 (llm-gate). 0이면 끔
# AGENT_OUTPUT_GUARD=log          # log=근거 없는 숫자는 기록만(반복 문장은 버림) / block / off
# AGENT_TOOL_ACK=0                # 조회 중 멘트 (latency). 팀 결정·매뉴얼 확인 전 꺼 둠
# AGENT_FIRST_CHUNK_MIN_CHARS=0   # 첫 조각 쉼표 끊기 (latency). 측정 때 8 사용
# AGENT_EOU_MODE=vad              # vad(기존) / soniox_stream(실제 키 미검증, 비교용)
# AGENT_PACK_DIR=                 # 묶음 폴더. 기본은 공식 묶음(team/agent/packs/official), 연습 묶음은 team/agent/prompts
# AGENT_BRAND_DIR=data/brand      # 당일 키트의 data/brand (시나리오·브랜드 정보·말투). git에 올리지 않음
